# Docker binds the app to localhost on the VPS and nginx proxies public traffic.
ANTELACUS_PORT=3002

# Next.js runtime settings inside the container.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Supabase dynamic-content foundation (`v2.1.0`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for projects still using legacy client keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production only: staging has none, so its admin reads but never writes. Admins are the users whose
# app_metadata.role is 'admin' (set once in SQL; docs/DEPLOYMENT.md).
SUPABASE_SERVICE_ROLE_KEY=

# Search engine verification (optional — get codes from each webmaster console).
SITE_VERIFICATION_GOOGLE=
SITE_VERIFICATION_BING=
SITE_VERIFICATION_BAIDU=

# Operations on the VPS: backups and the dead-man's switch. All optional locally. Read by the server jobs
# only: release.sh keeps them out of the app's container (appEnv in scripts/release/decide.mjs).
# The Supavisor session-pooler string from the dashboard (Connect → Session pooler); it reaches the
# database over IPv4. Only pg_dump reads it.
DATABASE_URL=
# Where backups land, outside the repository.
ANTELACUS_DATA_DIR=/home/deploy/antelacus-data
BACKUP_KEEP_DAYS=14
# pg_dump's major version: the server's or newer.
PG_MAJOR=17
# healthchecks.io ping URLs, one per job (keepalive, backup, site check). Empty = no reporting.
HC_PING_KEEPALIVE=
HC_PING_BACKUP=
HC_PING_SITE=
